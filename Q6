import java.util.Scanner;

public class Q6 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        long fatorial = 1;

        while (n > 1) {
            fatorial *= n;
            n--;
        }

        System.out.println(fatorial);

        sc.close();
    }
}
