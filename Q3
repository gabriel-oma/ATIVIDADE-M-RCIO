import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        double salario = SC.nextDouble();
        double contribuicao = 0.0;

        if (salario <= 1320.00) {
            contribuicao = salario * 0.075;
        } else if (salario <= 2571.29) {
            contribuicao = (1320.00 * 0.075) + ((salario - 1320.00) * 0.09);
        } else if (salario <= 3856.94) {
            contribuicao = (1320.00 * 0.075) + (1251.29 * 0.09) + ((salario - 2571.29) * 0.12);
        } else if (salario <= 7507.49) {
            contribuicao = (1320.00 * 0.075) + (1251.29 * 0.09) + (1285.65 * 0.12) + ((salario - 3856.94) * 0.14);
        } else {
            contribuicao = (1320.00 * 0.075) + (1251.29 * 0.09) + (1285.65 * 0.12) + (3650.55 * 0.14);
        }

        double salarioLiquido = salario - contribuicao;

        System.out.printf("Contribuicao: %.2f\n", contribuicao);
        System.out.printf("Salario Liquido: %.2f\n", salarioLiquido);

        sc.close();
    }
}
